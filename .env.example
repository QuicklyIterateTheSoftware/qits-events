# Local, per-machine overrides for running qits-events outside a container.
#
# COPY THIS FILE to `.env` (same directory, drop the .example) and edit. `.env` is gitignored;
# this one is tracked.
#
# Quarkus reads `.env` from the process's WORKING DIRECTORY at config ordinal 295 — above the
# packaged src/main/resources/application.properties (250), below real environment variables (300)
# and `-D` system properties (400). It overrides the shipped config without a rebuild, and works for
# the native binary as well as the fast-jar. Working directory means the repo root if you run:
#
#     ./service/target/qits-events
#
# Keys are ENVIRONMENT VARIABLE names, not property names: uppercase, dots and dashes to
# underscores. The payoff is that the same names work unchanged as real env vars in a container.

# --- ports ---------------------------------------------------------------------------------------
# quarkus.http.port. 8080 is the shipped default and every service in the platform claims it, so a
# local run needs its own. Note 8081 is taken on the deployment host by qits-artifacts' published
# npm registry — which is also why the test suite pins quarkus.http.test-port=0.
QUARKUS_HTTP_PORT=8095

# --- the database ----------------------------------------------------------------------------------
# quarkus.datasource.events.jdbc.url. The events jar defaults it to
# jdbc:h2:file:${user.home}/.qits/data/events/h2/events, which is right for a developer on a host and
# is what a plain local run uses. The deployment sets this variable to /data/events instead — the
# image names no default for it on purpose, so an unconfigured `docker run` fails loudly rather than
# writing a database that dies with the container.
#
# QUARKUS_DATASOURCE_EVENTS_JDBC_URL=jdbc:h2:file:/tmp/qits-local/events/h2/events
#
# Never add AUTO_SERVER=TRUE. It makes H2 start its own TCP server, whose class the native image
# loads by name and therefore does not have, so the binary dies at boot while every JVM run stays
# green.

# --- telemetry --------------------------------------------------------------------------------------
# qits.observability.url ships as the qits-net service name, which does NOT resolve on a host.
# Nothing breaks — the exporter is fire-and-forget — but it logs a warning every couple of seconds,
# which is most of what a local log will contain. Point it at nothing at all:
#
# QITS_OBSERVABILITY_URL=http://127.0.0.1:1
#
# Or turn the SDK off outright, which is what %dev and %test already do:
#
# QUARKUS_OTEL_SDK_DISABLED=true
